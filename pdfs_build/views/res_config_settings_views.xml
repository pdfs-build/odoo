<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pdfs_build</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="pdfs.build" string="pdfs.build" name="pdfs_build"
                     logo="/pdfs_build/static/description/icon.png">
                    <block title="Connection" name="pdfs_build_connection">
                        <setting id="pdfs_build_api_key_setting" string="API Key"
                                 help="Created under Developers &gt; API keys in the pdfs.build app. Shown once. Rendering over the API needs the Starter plan or higher.">
                            <field name="pdfs_build_api_key" password="True" placeholder="prs_..."/>
                            <div class="mt8">
                                <a href="https://app.pdfs.build/developers/api-keys" target="_blank" class="oe_link">
                                    <i class="oi oi-arrow-right"/> Open Developers &gt; API keys on pdfs.build
                                </a>
                            </div>
                        </setting>
                        <setting id="pdfs_build_organization_setting" string="Organization ID"
                                 help="Shown at the top of Developers &gt; API keys. It must be the organization the API key belongs to.">
                            <field name="pdfs_build_organization_id"/>
                        </setting>
                    </block>
                    <block title="Templates" name="pdfs_build_templates">
                        <setting id="pdfs_build_sync_setting" string="Sync" help="Check the connection, then pull the published templates of your organization into Odoo.">
                            <div class="mt8">
                                <button name="action_pdfs_build_test_connection" type="object"
                                        string="Test Connection" class="btn-primary me-2" icon="fa-plug"/>
                                <button name="action_pdfs_build_sync" type="object"
                                        string="Sync Templates" class="btn-secondary" icon="fa-refresh"/>
                            </div>
                            <div class="mt8">
                                <button name="%(pdfs_build.action_templates)d" type="action"
                                        string="Templates" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(pdfs_build.action_reports)d" type="action"
                                        string="Reports" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'pdfs_build'}</field>
    </record>
</odoo>
