<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pdfs_build</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="pdfs.build" string="pdfs.build" name="pdfs_build"
                     logo="/pdfs_build/static/description/icon.png">
                    <block title="Connection" name="pdfs_build_connection">
                        <!-- One box, labelled rows, full-width inputs: an organization ID is 32
                             characters and a key 50, and the default half-width field clips both. -->
                        <setting id="pdfs_build_connection_setting" string="pdfs.build account"
                                 help="Both come from Developers &gt; API keys in the pdfs.build app: the key is shown once when created, the Organization ID at the top of the page and must be the organization the key belongs to. Rendering over the API needs the Starter plan or higher.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="pdfs_build_api_key" class="col-lg-3 o_light_label"/>
                                    <div class="col-lg-9">
                                        <field name="pdfs_build_api_key" password="True" placeholder="prs_..." class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt8">
                                    <label for="pdfs_build_organization_id" class="col-lg-3 o_light_label"/>
                                    <div class="col-lg-9">
                                        <field name="pdfs_build_organization_id" placeholder="32 characters" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                            <div class="mt8">
                                <a href="https://app.pdfs.build/developers/api-keys" target="_blank" class="oe_link">
                                    <i class="oi oi-arrow-right"/> Open Developers &gt; API keys on pdfs.build
                                </a>
                            </div>
                        </setting>
                    </block>
                    <block title="Templates" name="pdfs_build_templates">
                        <setting id="pdfs_build_sync_setting" string="Sync" help="Check the connection, then pull the published templates of your organization into Odoo.">
                            <div class="mt8">
                                <button name="action_pdfs_build_test_connection" type="object"
                                        string="Test Connection" class="btn-primary me-2" icon="fa-plug"/>
                                <button name="action_pdfs_build_sync" type="object"
                                        string="Sync Templates" class="btn-secondary" icon="fa-refresh"/>
                            </div>
                            <div class="mt8">
                                <button name="%(pdfs_build.action_gallery)d" type="action"
                                        string="Designs for Odoo" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(pdfs_build.action_templates)d" type="action"
                                        string="Templates" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(pdfs_build.action_reports)d" type="action"
                                        string="Reports" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'pdfs_build'}</field>
    </record>
</odoo>
